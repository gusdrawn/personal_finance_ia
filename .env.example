# ───────────────────────────────────────────────────────────────────
# Variables de entorno para la app `banca`.
# Copia este archivo a `.env` y complétalo. NO commitear el `.env` real.
# (En desarrollo puedes exportarlas en tu shell antes de correr el server.)
# ───────────────────────────────────────────────────────────────────

# Llave Fernet para cifrar las credenciales bancarias.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANCA_FERNET_KEY=

# OpenRouter — clasificación de movimientos con IA
OPENROUTER_API_KEY=

# Telegram — avisos de presupuesto / gastos

# Centro de investigación de mercado. La interfaz nunca muestra cifras demo.
# Yahoo Finance (sin clave) o Twelve Data: precios. SEC EDGAR: fundamentales oficiales.
# FRED: series macro (adaptador disponible). Las claves cripto se gestionan en la web.
TRADING_DATA_MODE=LIVE
TRADING_TWELVE_DATA_API_KEY=
TRADING_FMP_API_KEY=
TRADING_FRED_API_KEY=

# Celery (opcional). Si no hay broker disponible, la sync corre inline.
CELERY_BROKER_URL=redis://localhost:6379/0

# Directorio donde bank_sync guarda la sesión del navegador (opcional)
# BANK_SYNC_SESSION_DIR=~/.bank_sync/sessions

# OCR para órdenes y certificados municipales escaneados (opcional si todos los
# PDFs ya traen texto). En Windows apunta al ejecutable de Tesseract.
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# cPanel (solo para herramientas de despliegue; nunca subir el .env real)
# En GitHub Actions estos valores se crean como secretos con los nombres documentados
# en README.md; el token no es la contraseña de acceso al panel.
# CPANEL_USERNAME=
# CPANEL_PASSWORD=  # API token; no es la contraseña de acceso
# CPANEL_API_TOKEN=  # nombre usado por GitHub Actions
# CPANEL_HOST=server199.web-hosting.com
# CPANEL_APP_ROOT=/home/gustzyif/finance_app
# CPANEL_PYTHON_BIN=/home/gustzyif/virtualenv/finance_app/3.13/bin/python

# Producción Django (en cPanel se configuran como variables de Passenger).
# En local puedes usar DJANGO_DEBUG=1. En producción se requieren DJANGO_SECRET_KEY
# y DJANGO_ALLOWED_HOSTS explícitos; la aplicación falla al iniciar si faltan.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=finance.gustavoguillen.com
# CSRF_TRUSTED_ORIGINS=https://finance.gustavoguillen.com
# FORCE_SCRIPT_NAME=  # vacío al publicar en la raíz del subdominio
# STATIC_URL=/static/
# MEDIA_URL=/media/
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
