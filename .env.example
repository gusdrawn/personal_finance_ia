# ───────────────────────────────────────────────────────────────────
# Variables de entorno para la app `banca`.
# Copia este archivo a `.env` y complétalo. NO commitear el `.env` real.
# (En desarrollo puedes exportarlas en tu shell antes de correr el server.)
# ───────────────────────────────────────────────────────────────────

# Llave Fernet para cifrar las credenciales bancarias.
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANCA_FERNET_KEY=

# OpenRouter — clasificación de movimientos con IA
OPENROUTER_API_KEY=

# Telegram — avisos de presupuesto / gastos
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Celery (opcional). Si no hay broker disponible, la sync corre inline.
CELERY_BROKER_URL=redis://localhost:6379/0

# Directorio donde bank_sync guarda la sesión del navegador (opcional)
# BANK_SYNC_SESSION_DIR=~/.bank_sync/sessions

# cPanel (solo para herramientas de despliegue; nunca subir el .env real)
# CPANEL_USERNAME=
# CPANEL_PASSWORD=  # API token; no es la contraseña de acceso

# Producción Django (en cPanel se configuran como variables de Passenger)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=finance.gustavoguillen.com
# CSRF_TRUSTED_ORIGINS=https://finance.gustavoguillen.com
# FORCE_SCRIPT_NAME=  # vacío al publicar en la raíz del subdominio
# STATIC_URL=/static/
# MEDIA_URL=/media/
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
